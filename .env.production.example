# PROCHEECK — production environment template
# Copy to `.env` on the server and fill in real values. Do NOT commit `.env`.

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=procheeck
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=procheeck

# --- Backend ---
NODE_ENV=production
PORT=4000
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_64_CHARS
JWT_EXPIRES_IN=7d
APP_URL=https://app.procheeck.mx
SWAGGER_ENABLED=false

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=PROCHEECK <no-reply@procheeck.mx>

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.procheeck.mx/api

# --- Backups ---
BACKUP_KEEP_DAYS=30
BACKUP_CRON=0 3 * * *

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
